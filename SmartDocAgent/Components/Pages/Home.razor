@page "/"
@inject DocumentAgentService AgentService
@inject DocumentIngester Ingester
@inject ISnackbar Snackbar

<MudGrid>
    <!-- LEFT SIDEBAR -->
    <MudItem xs="3">
        <MudPaper Class="pa-4" Style="height:80vh; overflow-y:auto;">
            <MudText Typo="Typo.h6" Class="mb-4">
                <MudIcon Icon="@Icons.Material.Filled.FolderOpen" />
                Documents
            </MudText>

            <!-- Upload -->
            <MudFileUpload T="IBrowserFile"
                           FilesChanged="OnFileUpload"
                           Accept=".pdf,.txt">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Upload"
                               FullWidth="true">
                        Upload Document
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>

            @if (_isUploading)
            {
                <MudProgressLinear Color="Color.Primary"
                                   Indeterminate="true"
                                   Class="mt-2" />
                <MudText Typo="Typo.caption">Ingesting document...</MudText>
            }

            <!-- Document List -->
            <MudList T="string" Class="mt-4">
                @foreach (var doc in _uploadedDocs)
                {
                    <MudListItem T="string">
                        <MudIcon Icon="@Icons.Material.Filled.Description"
                                 Class="mr-2" />
                        @doc
                    </MudListItem>
                }
            </MudList>
        </MudPaper>
    </MudItem>

    <!-- MAIN CHAT AREA -->
    <MudItem xs="9">
        <MudPaper Class="pa-4" Style="height:90vh; display:flex; flex-direction:column;">

            <MudText Typo="Typo.h6" Class="mb-4">
                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" />
                AI Document Assistant
            </MudText>

            <!-- Chat Messages -->
            <MudPaper Elevation="0"
                      Style="flex:1; overflow-y:auto; padding:16px;"
                      Class="mb-4">
                @foreach (var msg in _messages)
                {
                    <div class="@(msg.IsUser ? "d-flex justify-end mb-3" : "d-flex justify-start mb-3")">
                        <MudPaper Elevation="2"
                                  Class="pa-3"
                                  Style="@(msg.IsUser ?
                                                                      "background:#1976d2; color:white; max-width:70%; border-radius:16px 16px 0 16px;" :
                                                                      "max-width:70%; border-radius:16px 16px 16px 0;")">
                        <MudText>@msg.Content</MudText>
                        @if (msg.Sources.Any())
                            {
                                <MudDivider Class="my-2" />
                                <MudText Typo="Typo.caption">
                                    📌 Sources: @string.Join(", ", msg.Sources)
                                </MudText>
                            }
                        </MudPaper>
                    </div>
                }

                @if (_isThinking)
                {
                    <div class="d-flex justify-start mb-3">
                        <MudPaper Elevation="2" Class="pa-3" Style="border-radius:16px;">
                            <MudProgressCircular Size="Size.Small"
                                                 Indeterminate="true"
                                                 Class="mr-2" />
                            <MudText Typo="Typo.caption">
                                Agent is thinking...
                            </MudText>
                        </MudPaper>
                    </div>
                }
            </MudPaper>

            <!-- Input Area -->
            <MudGrid>
                <MudItem xs="10">
                    <MudTextField @bind-Value="_userInput"
                                  Placeholder="Ask anything about your documents..."
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  OnKeyDown="OnKeyDown" />
                </MudItem>
                <MudItem xs="2">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Style="height:56px;"
                               OnClick="SendMessage"
                               Disabled="_isThinking"
                               EndIcon="@Icons.Material.Filled.Send">
                        Send
                    </MudButton>
                </MudItem>
            </MudGrid>

        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private string _userInput = "";
    private bool _isThinking = false;
    private bool _isUploading = false;
    private List<string> _uploadedDocs = new();
    private List<ChatMessage> _messages = new();

    private async Task OnFileUpload(IBrowserFile file)
    {
        _isUploading = true;
        StateHasChanged();

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            await Ingester.IngestDocumentAsync(stream, file.Name);
            _uploadedDocs.Add(file.Name);
            Snackbar.Add($"{file.Name} ingested successfully!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isUploading = false;
            StateHasChanged();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_userInput)) return;

        var question = _userInput;
        _userInput = "";
        _isThinking = true;

        _messages.Add(new ChatMessage
        {
            Content = question,
            IsUser = true
        });

        StateHasChanged();

        try
        {
            var response = await AgentService.AskAsync(question);
            _messages.Add(new ChatMessage
            {
                Content = response.Answer,
                IsUser = false,
                Sources = response.Sources
            });
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isThinking = false;
            StateHasChanged();
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SendMessage();
    }

    public class ChatMessage
    {
        public string Content { get; set; } = "";
        public bool IsUser { get; set; }
        public List<string> Sources { get; set; } = new();
    }
}